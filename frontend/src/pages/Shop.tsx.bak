import { useEffect, useState, useMemo } from 'react';
import { Search, ChevronDown, Sparkles, Heart, CakeSlice, Shield, Truck } from 'lucide-react';
import { supabase } from '../lib/supabase';
import type { Product } from '../types';
import ProductCard from '../components/ProductCard';
import Footer from \x27../components/Footer\x27;\nimport { SkeletonGrid } from \x27../components/Skeleton\x27;

const categories = [
  { name: 'All', slug: 'all', icon: Sparkles },
  { name: 'Birthday', slug: 'birthday', icon: Sparkles },
  { name: 'Wedding', slug: 'wedding', icon: Heart },
  { name: 'Cupcakes', slug: 'cupcake', icon: CakeSlice },
  { name: 'Custom', slug: 'custom', icon: Shield },
  { name: 'Pastries', slug: 'pastry', icon: Truck },
];

const sortOptions = [
  { value: 'newest', label: 'Newest' },
  { value: 'price-asc', label: 'Price: Low to High' },
  { value: 'price-desc', label: 'Price: High to Low' },
  { value: 'name-asc', label: 'Name: A-Z' },
  { value: 'name-desc', label: 'Name: Z-A' },
];

export default function Shop() {
  const [products, setProducts] = useState<Product[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [selectedCategory, setSelectedCategory] = useState('all');
  const [searchQuery, setSearchQuery] = useState('');
  const [sortBy, setSortBy] = useState('newest');

  useEffect(() => {
    async function fetchProducts() {
      try {
        const query = supabase
          .from('products')
          .select('*')
          .eq('is_available', true)
          .order('created_at', { ascending: false });

        const { data, error } = await query;

        if (error) throw error;
        setProducts(data || []);
      } catch (err) {
        setError((err as Error).message);
      } finally {
        setLoading(false);
      }
    }

    fetchProducts();
  }, []);

  const filteredProducts = useMemo(() => {
    let result = products;

    if (selectedCategory !== 'all') {
      result = result.filter((p) => p.category === selectedCategory);
    }

    if (searchQuery.trim()) {
      const query = searchQuery.toLowerCase().trim();
      result = result.filter(
        (p) =>
          p.name.toLowerCase().includes(query) ||
          p.description?.toLowerCase().includes(query) ||
          p.category.toLowerCase().includes(query)
      );
    }

    switch (sortBy) {
      case 'price-asc':
        result = [...result].sort((a, b) => a.price - b.price);
        break;
      case 'price-desc':
        result = [...result].sort((a, b) => b.price - a.price);
        break;
      case 'name-asc':
        result = [...result].sort((a, b) => a.name.localeCompare(b.name));
        break;
      case 'name-desc':
        result = [...result].sort((a, b) => b.name.localeCompare(a.name));
        break;
      case 'newest':
      default:
        result = [...result].sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());
        break;
    }

    return result;
  }, [products, selectedCategory, searchQuery, sortBy]);

  return (
    <div className="min-h-screen bg-surface" style={{ fontFamily: 'var(--font-family-body)' }}>
      <section className="py-12 md:py-16 px-4 bg-white border-b border-outline-variant" style={{ fontFamily: 'var(--font-family-display)' }}>
        <div className="mx-auto max-w-6xl">
          <div className="flex flex-col items-center text-center mb-10 md:mb-12 animate-fade-in">
            <span className="mb-4 inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold uppercase tracking-wider text-accent-gold border border-accent-gold/30 rounded-full"
              style={{ letterSpacing: '0.1em', fontFamily: 'var(--font-family-body)' }}
            >
              <Sparkles className="h-4 w-4" />
              Our Collection
            </span>
            <h1 className="text-3xl md:text-4xl lg:text-5xl font-bold text-primary leading-tight"
              style={{ fontFamily: 'var(--font-family-display)' }}
            >
              Discover Your Perfect Cake
            </h1>
            <p className="mt-4 text-base md:text-lg text-on-surface-variant max-w-2xl"
              style={{ fontFamily: 'var(--font-family-body)', lineHeight: '1.6' }}
            >
              Browse our handcrafted selection of luxury cakes, cupcakes, and pastries.
              Every piece is made fresh daily with the finest ingredients.
            </p>
          </div>

          <div className="flex flex-col lg:flex-row gap-8">
            <aside className="w-full lg:w-64 flex-shrink-0">
              <div className="bg-white p-6 rounded-xl border border-outline-variant sticky top-24 animate-slide-up">
                <h3 className="mb-4 font-semibold text-on-surface"
                  style={{ fontFamily: 'var(--font-family-display)', fontSize: '18px' }}
                >
                  Categories
                </h3>
                <div className="space-y-2">
                  {categories.map((cat) => (
                    <button
                      key={cat.slug}
                      onClick={() => setSelectedCategory(cat.slug)}
                      className={`w-full flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 text-left focus-ring ${
                        selectedCategory === cat.slug
                          ? 'bg-primary text-white'
                          : 'text-on-surface-variant hover:bg-surface-container hover:text-primary'
                      }`}
                      style={{ fontFamily: 'var(--font-family-body)', fontSize: '14px' }}
                    >
                      <cat.icon className={`h-5 w-5 ${selectedCategory === cat.slug ? 'text-accent-gold' : 'text-outline'}`} />
                      <span>{cat.name}</span>
                    </button>
                  ))}
                </div>

                <div className="mt-8 pt-6 border-t border-outline-variant">
                  <h3 className="mb-4 font-semibold text-on-surface"
                    style={{ fontFamily: 'var(--font-family-display)', fontSize: '18px' }}
                  >
                    Sort By
                  </h3>
                  <div className="relative">
                    <select
                      value={sortBy}
                      onChange={(e) => setSortBy(e.target.value)}
                      className="w-full appearance-none px-4 py-3 pr-10 bg-white border border-outline-variant rounded-lg text-primary focus:outline-none focus:border-accent-gold focus:ring-1 focus:ring-accent-gold focus-ring"
                      style={{ fontFamily: 'var(--font-family-body)', fontSize: '14px' }}
                    >
                      {sortOptions.map((opt) => (
                        <option key={opt.value} value={opt.value}>
                          {opt.label}
                        </option>
                      ))}
                    </select>
                    <ChevronDown className="absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-outline pointer-events-none" />
                  </div>
                </div>
              </div>
            </aside>

            <main className="flex-1">
              <div className="mb-6 flex flex-col sm:flex-row gap-4">
                <div className="relative flex-1">
                  <Search className="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-outline" />
                  <input
                    type="text"
                    placeholder="Search cakes, flavors, occasions..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    className="w-full pl-12 pr-4 py-3 bg-white border border-outline-variant rounded-lg text-primary placeholder-outline focus:outline-none focus:border-accent-gold focus:ring-1 focus:ring-accent-gold focus-ring"
                    style={{ fontFamily: 'var(--font-family-body)', fontSize: '14px' }}
                  />
                </div>
                <div className="flex items-center gap-2 text-sm text-on-surface-variant">
                  <span>{filteredProducts.length} product{filteredProducts.length !== 1 ? 's' : ''} found</span>
                </div>
              </div>

              {loading ? (
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 animate-fade-in">
                  {[1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
                    <div key={i} className="bg-white border border-outline-variant rounded-xl overflow-hidden skeleton">
                      <div className="aspect-[4/3]" />
                      <div className="p-5 space-y-4">
                        <div className="h-4 w-3/4 rounded skeleton" />
                        <div className="h-6 w-1/2 rounded skeleton" />
                        <div className="h-8 w-1/3 rounded skeleton" />
                      </div>
                    </div>
                  ))}
                </div>
              ) : error ? (
                <div className="text-center py-12 animate-fade-in">
                  <p className="text-red-500 mb-4">Failed to load products: {error}</p>
                  <button
                    onClick={() => window.location.reload()}
                    className="px-4 py-2 text-sm font-semibold text-white rounded-lg focus-ring"
                    style={{ backgroundColor: 'var(--color-primary-container)' }}
                  >
                    Retry
                  </button>
                </div>
              ) : filteredProducts.length === 0 ? (
                <div className="text-center py-16 animate-fade-in">
                  <CakeSlice className="mx-auto mb-4 h-16 w-16 text-outline-variant" />
                  <h3 className="text-xl font-semibold text-on-surface mb-2"
                    style={{ fontFamily: 'var(--font-family-display)' }}
                  >
                    No Products Found
                  </h3>
                  <p className="text-on-surface-variant mb-6">
                    {selectedCategory !== 'all' || searchQuery
                      ? 'Try adjusting your filters or search terms'
                      : 'No products available at the moment'}
                  </p>
                  {selectedCategory !== 'all' && (
                    <button
                      onClick={() => setSelectedCategory('all')}
                      className="text-accent-gold hover:underline focus-ring"
                      style={{ fontFamily: 'var(--font-family-body)' }}
                    >
                      Show all categories
                    </button>
                  )}
                </div>
              ) : (
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 animate-slide-up">
                  {filteredProducts.map((product) => (
                    <ProductCard key={product.id} product={product} />
                  ))}
                </div>
              )}
            </main>
          </div>
        </div>
      </section>

      <Footer />
    </div>
  );
}

